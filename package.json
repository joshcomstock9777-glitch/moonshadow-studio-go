{
  "name": "studiogo",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run test:path-client && npm run test:factory-publish && npm run test:headquarters-editor && npm run test:asset-storage && npm run test:renderer-health",
    "test:path-client": "node --experimental-strip-types --test scripts/pathClient.contract.test.mjs",
    "test:factory-publish": "node --experimental-strip-types --test scripts/factoryPublish.contract.test.mjs",
    "test:headquarters-editor": "node --experimental-strip-types --test scripts/headquartersEditor.contract.test.mjs",
    "test:asset-storage": "node --experimental-strip-types --test scripts/assetStorage.contract.test.mjs",
    "test:renderer-health": "node --experimental-strip-types --test scripts/rendererHealth.contract.test.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true
}
